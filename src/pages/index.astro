---
import Layout from '../components/Layout.astro';
import { allSources, loadCities } from '../lib/data';
import { withBase } from '../lib/url';

const cities = loadCities();
const tz = cities[0]?.timezone ?? 'America/Monterrey';
// With a single city there is nothing to choose: go straight to it.
const only = cities.length === 1 ? cities[0] : null;
const target = only ? withBase(`${only.slug}/`) : null;
---
<Layout
  title={only ? `Qué hacer en ${only.name}` : 'Qué hacer: eventos en tu ciudad'}
  description="Conciertos, teatro, cine, exposiciones y más, reunidos de varias fuentes en un solo lugar."
  sources={allSources(cities)}
  timeZone={tz}
  canonicalPath={target ?? undefined}
>
  {target && <meta slot="head" http-equiv="refresh" content={`0; url=${target}`} />}
  <h1 class="sr-only">Qué hacer</h1>
  {only && (
    <p class="lead">Abriendo {only.name}… Si no cambia la página, <a href={target!}>ve a los eventos en {only.name}</a>.</p>
  )}
  {!only && cities.length > 0 && <p class="lead">Elige tu ciudad:</p>}
  {cities.length === 0 && <p class="empty">Todavía no hay datos. Genera los archivos con el comando <code>export-site</code> del exportador de datos.</p>}
  {!only && (
    <ul class="city-list">
      {cities.map((c) => (
        <li>
          <a class="city-link" href={withBase(`${c.slug}/`)}>
            <span class="city-name">{c.name}</span>
            <span class="city-count">{c.events.length} eventos próximos</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</Layout>
