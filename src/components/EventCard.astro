---
import { categoryLabel } from '../lib/filters';
import { formatTime, formatVenue } from '../lib/format';
import type { EventItem } from '../lib/types';

interface Props {
  event: EventItem;
  timeZone: string;
}
const { event, timeZone } = Astro.props;
// The winning source first, then every other contributing source (a Ticketmaster page must stay reachable).
const primary = event.url ? { name: event.source, url: event.url } : null;
const others = event.sources.filter((s) => s.url && s.url !== event.url && s.name !== event.source);
---
<li class="event" data-id={event.id} data-cat={event.category}>
  {event.image_url && (
    <img class="event-img" src={event.image_url} alt={`Imagen del evento: ${event.title}`} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
  )}
  <div class="event-body">
    <p class="event-meta">
      <time datetime={event.start}>{event.has_time ? formatTime(event.start, timeZone) : 'Hora por confirmar'}</time>
      <span class="cat"><span class="dot" data-dot={event.category} aria-hidden="true"></span>{categoryLabel(event.category)}</span>
      {event.is_free === true && <span class="badge">Gratis</span>}
    </p>
    <h3 class="event-title">{event.title}</h3>
    {event.venue && <p class="event-venue">{formatVenue(event.venue)}</p>}
    <p class="event-links">
      {primary && <a href={primary.url} rel="noopener noreferrer" target="_blank">Ver en {primary.name}</a>}
      {others.map((s) => <a class="also" href={s.url!} rel="noopener noreferrer" target="_blank">También en {s.name}</a>)}
    </p>
  </div>
</li>
