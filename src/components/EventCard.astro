---
import { categoryLabel } from '../lib/filters';
import { formatTime, shortVenue } from '../lib/format';
import type { EventItem } from '../lib/types';

interface Props {
  event: EventItem;
  timeZone: string;
}
const { event, timeZone } = Astro.props;
// The winning source is the main link; every other contributing source stays reachable as a quiet extra link.
const others = event.sources.filter((s) => s.url && s.url !== event.url && s.name !== event.source);
---
<li class="event" data-id={event.id} data-cat={event.category}>
  <p class="ev-time">
    {event.has_time ? <time datetime={event.start}>{formatTime(event.start, timeZone)}</time> : <time datetime={event.start} class="tbc">Hora por confirmar</time>}
  </p>
  <div class="ev-text">
    <h3 class="event-title">
      {event.url ? (
        <a class="ev-link" href={event.url} rel="noopener noreferrer" target="_blank">{event.title}<span class="sr-only"> (en {event.source}, se abre en otra pestaña)</span></a>
      ) : (
        event.title
      )}
    </h3>
    {event.venue && <p class="event-venue">{shortVenue(event.venue)}</p>}
    <p class="event-meta">
      <span class="cat"><span class="dot" data-dot={event.category} aria-hidden="true"></span>{categoryLabel(event.category)}</span>
      {event.is_free === true && <span class="badge">Gratis</span>}
      <span class="src">{event.source}</span>
    </p>
    {others.length > 0 && (
      <p class="also-links">
        {others.map((s) => <a href={s.url!} rel="noopener noreferrer" target="_blank">También en {s.name}</a>)}
      </p>
    )}
  </div>
  {event.image_url && (
    <img class="event-img" src={event.image_url} alt="" width="72" height="72" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
  )}
</li>
