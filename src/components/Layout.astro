---
import '../styles/global.css';
import { withBase } from '../lib/url';
import { formatUpdated } from '../lib/format';
import { loadCities, meta } from '../lib/data';
import { imageHosts } from '../lib/privacy';
import type { SourceRef } from '../lib/types';

interface Props {
  title: string;
  description: string;
  sources: SourceRef[];
  timeZone: string;
  citySlug?: string; // the city being viewed, for the switcher
  canonicalPath?: string; // overrides the canonical link (a redirect page points at its target)
}
const { title, description, sources, timeZone, citySlug, canonicalPath } = Astro.props;
const cities = loadCities();
const current = cities.find((c) => c.slug === citySlug);
const hosts = imageHosts(cities);
const canonical = Astro.site ? new URL(canonicalPath ?? Astro.url.pathname, Astro.site).href : null;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <slot name="head" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <a class="brand" href={withBase('')}>Qué hacer</a>
      {current && cities.length > 1 && (
        <details class="city-switch">
          <summary><span class="sr-only">Ciudad: </span>{current.name}</summary>
          <ul>
            {cities.map((c) => (
              <li><a href={withBase(`${c.slug}/`)} aria-current={c.slug === current.slug ? 'page' : undefined}>{c.name}</a></li>
            ))}
          </ul>
        </details>
      )}
      {current && cities.length === 1 && <span class="city-current"><span class="sr-only">Ciudad: </span>{current.name}</span>}
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="site-footer">
      {sources.length > 0 && (
        <p>
          Datos de:{' '}
          {sources.map((s, i) => (
            <>
              {i > 0 && ', '}
              {s.url ? <a href={s.url} rel="noopener noreferrer" target="_blank">{s.name}</a> : s.name}
            </>
          ))}
          .
        </p>
      )}
      <p class="notice">Los eventos provienen de fuentes de terceros y cada uno enlaza a su página original. No se reclaman derechos sobre esos datos.</p>
      <p class="privacy">
        Este sitio no usa cookies, analítica ni scripts, fuentes o estilos de terceros.
        {hosts.length > 0 && <>Las imágenes de los eventos se cargan directamente desde {hosts.join(', ')}, que pueden ver tu dirección IP; no les enviamos referencia.</>}
        {' '}<a href={withBase('aviso/')}>Aviso y retiro de contenido</a>.
      </p>
      <p>Actualizado: <time datetime={meta.generated_at}>{formatUpdated(meta.generated_at, timeZone)}</time> (hora local). Verifica horarios y precios en la página original.</p>
    </footer>
  <script>
    // Images that fail to load (a source moved or blocked them) simply disappear; the row stays complete.
    document.addEventListener(
      'error',
      (e) => {
        const el = e.target;
        if (el instanceof HTMLImageElement) {
          el.closest('.event')?.classList.add('no-image');
          el.remove();
        }
      },
      true,
    );
  </script>
  </body>
</html>
