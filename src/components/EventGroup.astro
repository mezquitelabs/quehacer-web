---
import { formatTime, shortVenue } from '../lib/format';
import { categoryLabel } from '../lib/filters';
import { dominantCategory, groupKind, groupNoun, timeRange } from '../lib/group';
import type { EventItem } from '../lib/types';

interface Props {
  venue: string; // already formatted for display (formatVenue)
  events: EventItem[];
  timeZone: string;
}
const { venue, events, timeZone } = Astro.props;
const n = events.length;
const kind = groupKind(events);
const category = dominantCategory(events) ?? 'other';
const times = events.filter((e) => e.has_time).map((e) => formatTime(e.start, timeZone));
const range = timeRange(times);
const [rangeStart, rangeEnd] = range ? range.split('–') : [null, null];
---
<li class="event group" data-group data-kind={kind} data-cat={category}>
  <details>
    <summary>
      <span class="ev-time range-time" data-group-range>
        {range ? <><span>{rangeStart}</span>{rangeEnd && <span>–{rangeEnd}</span>}</> : <span class="tbc">Hora por confirmar</span>}
      </span>
      <span class="ev-text">
        <span class="event-title">{shortVenue(venue)}</span>
        <span class="event-meta">
          <span class="cat"><span class="dot" data-dot={category} aria-hidden="true"></span>{categoryLabel(category)}</span>
          <span class="group-count"><span data-group-n>{n}</span> <span data-group-label>{groupNoun(kind, n)}</span></span>
        </span>
      </span>
    </summary>
    <ul class="functions">
      {events.map((event) => {
        const others = event.sources.filter((s) => s.url && s.url !== event.url && s.name !== event.source);
        return (
          <li class="fn" data-id={event.id} data-cat={event.category} data-time={event.has_time ? formatTime(event.start, timeZone) : ''}>
            <time datetime={event.start} class={event.has_time ? undefined : 'tbc'}>{event.has_time ? formatTime(event.start, timeZone) : 'Hora por confirmar'}</time>
            <span class="fn-main">
              <span class="fn-title">
                {event.url ? (
                  <a class="ev-link" href={event.url} rel="noopener noreferrer" target="_blank">{event.title}<span class="sr-only"> (en {event.source}, se abre en otra pestaña)</span></a>
                ) : (
                  event.title
                )}
                {event.is_free === true && <span class="badge">Gratis</span>}
              </span>
              {others.length > 0 && (
                <span class="also-links">
                  {others.map((s) => <a href={s.url!} rel="noopener noreferrer" target="_blank">También en {s.name}</a>)}
                </span>
              )}
            </span>
          </li>
        );
      })}
    </ul>
  </details>
</li>
